@@ -0,0 +1,100 @@
+"""Retry behaviour of notify.client.send against a stand-in Kestrel.
+
+The duplicate-alert incident these cover: a retry that Kestrel cannot recognize
+as a retry becomes a second delivered SMS.
+"""
+
+import http.server
+import json
+import os
+import threading
+import time
+import unittest
+
+
+class FakeKestrel:
+    """Records the Idempotency-Key of every attempt; fails the first `fail_first`."""
+
+    def __init__(self, fail_first, mode="503"):
+        self.keys = []
+        outer = self
+
+        class Handler(http.server.BaseHTTPRequestHandler):
+            def do_POST(self):
+                outer.keys.append(self.headers.get("Idempotency-Key"))
+                self.rfile.read(int(self.headers.get("Content-Length", 0)))
+                if len(outer.keys) <= fail_first:
+                    if mode == "timeout":
+                        # Outlive the client's TIMEOUT: Kestrel has the message,
+                        # the client never hears so.
+                        time.sleep(client.TIMEOUT + 3)
+                        return
+                    self.send_response(503)
+                    self.end_headers()
+                    self.wfile.write(b"upstream down")
+                    return
+                body = json.dumps({"message_id": f"msg-{len(outer.keys)}"}).encode()
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, *args):
+                pass
+
+        self.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+
+    def __enter__(self):
+        threading.Thread(target=self.server.serve_forever, daemon=True).start()
+        client.BASE = f"http://127.0.0.1:{self.server.server_address[1]}"
+        return self
+
+    def __exit__(self, *exc):
+        self.server.shutdown()
+
+
+os.environ.setdefault("KESTREL_TOKEN", "test-token")
+os.environ["KESTREL_BASE"] = "http://127.0.0.1:1"
+from notify import client  # noqa: E402  (import after env so module constants bind)
+
+
+class RetriesDoNotDuplicate(unittest.TestCase):
+    def setUp(self):
+        self._base, self._backoff = client.BASE, client.BACKOFF
+        client.BACKOFF = 0.05
+        self.addCleanup(setattr, client, "BASE", self._base)
+        self.addCleanup(setattr, client, "BACKOFF", self._backoff)
+
+    def test_retry_after_5xx_reuses_one_idempotency_key(self):
+        with FakeKestrel(fail_first=2) as kestrel:
+            self.assertEqual(client.send("+15550100", "disk full"), "msg-3")
+        self.assertEqual(len(kestrel.keys), 3, "expected all retries to be spent")
+        self.assertEqual(
+            len(set(kestrel.keys)), 1, "each retry asked Kestrel for a new message"
+        )
+
+    def test_retry_after_timeout_reuses_one_idempotency_key(self):
+        with FakeKestrel(fail_first=1, mode="timeout") as kestrel:
+            self.assertEqual(client.send("+15550100", "disk full"), "msg-2")
+        self.assertEqual(len(kestrel.keys), 2)
+        self.assertEqual(len(set(kestrel.keys)), 1)
+
+    def test_separate_sends_get_separate_keys(self):
+        with FakeKestrel(fail_first=0) as kestrel:
+            client.send("+15550100", "disk full")
+            client.send("+15550100", "disk full")
+        self.assertEqual(len(set(kestrel.keys)), 2, "distinct alerts must not collapse")
+
+    def test_no_backoff_sleep_after_the_final_attempt(self):
+        naps, real_sleep = [], client.time.sleep
+        client.time.sleep = naps.append
+        self.addCleanup(setattr, client.time, "sleep", real_sleep)
+        with FakeKestrel(fail_first=client.RETRIES):
+            with self.assertRaises(RuntimeError):
+                client.send("+15550100", "disk full")
+        self.assertEqual(len(naps), client.RETRIES - 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
