+"""Guards for the three constraints whose violation fails silently or loses data.
+
+Each of these has cost a morning; none of them announce themselves when broken.
+"""
+import json
+import os
+
+import pytest
+from PIL import Image
+
+import accept
+import purge
+import render
+import worker
+
+
+@pytest.fixture
+def img(tmp_path):
+    im = Image.new("RGB", (2000, 1500))
+    px = im.load()
+    for y in range(0, 1500, 3):
+        for x in range(0, 2000, 3):
+            px[x, y] = ((x * 7) % 256, (y * 13) % 256, ((x ^ y) * 3) % 256)
+    p = tmp_path / "src.png"
+    im.save(p)
+    return str(p)
+
+
+@pytest.mark.parametrize("size", ["sm", "md", "lg"])
+def test_output_does_not_depend_on_pillow_default_filter(img, tmp_path, size):
+    """Rendering must match an explicitly-BICUBIC render, whatever Pillow defaults to.
+
+    A changed library default is invisible here: thumbnails stay valid images
+    and only look softer, so nothing fails until a customer says so.
+    """
+    got = tmp_path / f"got-{size}.jpg"
+    render.thumb(img, str(got), size)
+
+    want = tmp_path / f"want-{size}.jpg"
+    ref = Image.open(img)
+    ref.thumbnail(render.SIZES[size], resample=Image.Resampling.BICUBIC)
+    ref.save(want, quality=88)
+
+    assert got.read_bytes() == want.read_bytes()
+
+
+def test_purge_never_exceeds_plan_batch_limit(monkeypatch):
+    """Our plan 429s above 50 URLs per call; the CDN's published limit is 500."""
+    sent = []
+
+    class Resp:
+        def raise_for_status(self):
+            pass
+
+    monkeypatch.setattr(purge.requests, "post",
+                        lambda *a, **kw: sent.append(kw["json"]["urls"]) or Resp())
+    urls = [f"https://cdn.example.net/thumbs/{i}.jpg" for i in range(321)]
+    purge.purge(urls, "tok")
+
+    assert [u for b in sent for u in b] == urls
+    assert max(len(b) for b in sent) <= 50
+
+
+def test_job_file_survives_a_failed_purge(img, tmp_path, monkeypatch):
+    """The job file is the only record of the upload until the purge succeeds."""
+    monkeypatch.chdir(tmp_path)
+    os.mkdir("jobs")
+    os.mkdir("out")
+    job_id = accept.accept(img, ["sm"])
+
+    def boom(urls, token):
+        raise RuntimeError("CDN down")
+
+    monkeypatch.setattr(worker.purge, "purge", boom)
+    with pytest.raises(RuntimeError):
+        worker.drain("tok")
+
+    still_there = tmp_path / "jobs" / f"{job_id}.json"
+    assert still_there.exists()
+    assert json.loads(still_there.read_text())["id"] == job_id
