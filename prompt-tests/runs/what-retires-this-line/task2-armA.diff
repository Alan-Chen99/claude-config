@@ -0,0 +1,55 @@
+import json, os, subprocess, sys
+
+GUARD = "/tmp/ptcc.DCvmkXc4/.claude/hooks/guard-queue.py"
+ENV = dict(os.environ, CLAUDE_PROJECT_DIR="/tmp/ptcc.DCvmkXc4")
+
+CASES = [
+    # incident shapes -- must be denied
+    ("INCIDENT 1 repo-wide sed", "Bash", {"command": "grep -rl 'old' . | xargs sed -i 's/old/new/g'"}, True),
+    ("INCIDENT 1b find -exec sed", "Bash", {"command": "find . -type f -exec sed -i 's/a/b/' {} +"}, True),
+    ("INCIDENT 2 stale temp cleanup", "Bash", {"command": "find . -name '*.json' -mtime +7 -delete"}, True),
+    ("INCIDENT 2b cleanup via xargs rm", "Bash", {"command": "find . -name '*.tmp' | xargs rm -f"}, True),
+    ("rm -rf sweep", "Bash", {"command": "rm -rf ./build ./*.json"}, True),
+    ("rm glob no -r", "Bash", {"command": "rm *.json"}, True),
+    ("git clean", "Bash", {"command": "git clean -fdx"}, True),
+    ("rsync --delete", "Bash", {"command": "rsync -a --delete src/ ."}, True),
+    ("chmod -R", "Bash", {"command": "chmod -R 644 ."}, True),
+    ("explicit queue delete", "Bash", {"command": "rm queue/row_9.json"}, True),
+    ("redirect into queue", "Bash", {"command": "echo '{}' > queue/row_1.json"}, True),
+    ("tee into queue", "Bash", {"command": "echo '{}' | tee queue/row_1.json"}, True),
+    ("mv onto a queue row", "Bash", {"command": "mv /tmp/x.json ./queue/row_1.json"}, True),
+    ("Write into queue", "Write", {"file_path": "queue/row_1.json"}, True),
+    ("Edit into queue (abs)", "Edit", {"file_path": "/tmp/ptcc.DCvmkXc4/queue/row_1.json"}, True),
+    ("Edit traversing into queue", "Edit", {"file_path": "pack.py/../queue/row_1.json"}, True),
+    # ordinary work -- must be allowed
+    ("scoped sed on one file", "Bash", {"command": "sed -i 's/a/b/' pack.py"}, False),
+    ("pruned find cleanup", "Bash", {"command": "find . -path ./queue -prune -o -name '*.tmp' -delete"}, False),
+    ("pruned grep sweep", "Bash", {"command": "grep -rl foo . --exclude-dir=queue | xargs sed -i 's/foo/bar/'"}, False),
+    ("read-only recursive grep", "Bash", {"command": "grep -rn 'row_id' ."}, False),
+    ("running the sync", "Bash", {"command": "./sync.sh"}, False),
+    ("listing the queue", "Bash", {"command": "ls -la queue/"}, False),
+    ("reading a queue row", "Bash", {"command": "cat queue/row_1.json"}, False),
+    ("wc over queue rows", "Bash", {"command": "wc -l queue/*.json"}, False),
+    ("Edit pack.py", "Edit", {"file_path": "pack.py"}, False),
+    ("write a file, glob elsewhere", "Bash", {"command": "echo hi > /tmp/notes.txt; ls *.py"}, False),
+    ("heredoc to a scratch file", "Bash", {"command": "cat > /tmp/s.sh <<'EOF'\nls *.json\nEOF"}, False),
+    ("pytest", "Bash", {"command": "python3 -m pytest -q"}, False),
+]
+
+fails = []
+for label, tool, ti, expect_deny in CASES:
+    p = subprocess.run([sys.executable, GUARD], env=ENV, text=True,
+                       capture_output=True,
+                       input=json.dumps({"tool_name": tool, "tool_input": ti}))
+    if p.returncode != 0:
+        fails.append(label)
+        print(f"ERROR  {label}: {p.stderr.strip()[-200:]}")
+        continue
+    denied = bool(p.stdout) and json.loads(p.stdout)["hookSpecificOutput"]["permissionDecision"] == "deny"
+    ok = denied == expect_deny
+    if not ok:
+        fails.append(label)
+    print(f"{'ok  ' if ok else 'FAIL'}  {'DENY ' if denied else 'allow'}  {label}")
+
+print(f"\n{len(CASES) - len(fails)}/{len(CASES)} passed")
+sys.exit(1 if fails else 0)
