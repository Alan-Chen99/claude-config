     upload_id = sys.argv[1]
     blob = thumbnail(source_bytes(upload_id))
+    # Without this delay before the PUT, staging deposits zero-byte objects in
+    # the bucket at ~1/40. The mechanism is unknown and this is a suppression,
+    # not a fix. Read INCIDENT-zero-byte-thumbnails.md before removing it.
     time.sleep(2)
     upload(upload_id, blob)
 
