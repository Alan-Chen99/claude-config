+"""Guards for values that incidents set and documentation contradicts.
+
+They read source text instead of importing, so they run without Pillow or
+requests installed. CLAUDE.md carries the full account behind each one.
+"""
+import pathlib
+import re
+
+ROOT = pathlib.Path(__file__).parent
+
+
+def test_purge_chunk_within_plan_limit():
+    chunk = re.search(r"^CHUNK\s*=\s*(\d+)", (ROOT / "purge.py").read_text(), re.M)
+    assert chunk, "purge.py no longer defines CHUNK"
+    assert int(chunk.group(1)) <= 50, (
+        "Batches past ~200 URLs returned 429 on our CDN plan; 50 stopped them. "
+        "The 500 the CDN documents is the enterprise plan, so finding it in "
+        "their docs is not grounds to raise this. Raise it only against written "
+        "terms for our plan or a reproduction on it. See CLAUDE.md."
+    )
+
+
+def test_pillow_pin_unchanged():
+    pinned = re.search(r"^Pillow==(\S+)", (ROOT / "requirements.txt").read_text(), re.M)
+    assert pinned, "requirements.txt no longer pins Pillow"
+    assert pinned.group(1) == "10.2.0", (
+        f"Pillow moved to {pinned.group(1)}. 10.3.0 produced visibly softer 'md' "
+        "thumbnails in production and the cause was never found -- it is NOT the "
+        "resample= default, which is BICUBIC in both versions and produces "
+        "byte-identical output. Passing resample= does not make this bump safe. "
+        "Render real production uploads under both versions and compare before "
+        "moving the pin. See CLAUDE.md."
+    )
+
+
+def test_no_print_calls():
+    offenders = [
+        f"{path.name}:{n}"
+        for path in sorted(ROOT.glob("*.py"))
+        if path.name != pathlib.Path(__file__).name
+        for n, line in enumerate(path.read_text().splitlines(), 1)
+        if re.search(r"(?<![\w.])print\s*\(", line)
+    ]
+    assert not offenders, (
+        f"print() at {', '.join(offenders)}; this repo logs instead. "
+        "Use a module logger -- see CLAUDE.md."
+    )
