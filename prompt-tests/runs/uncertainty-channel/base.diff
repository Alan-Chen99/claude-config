@@ -0,0 +1,93 @@
+"""Integration tests for the Kestrel client against a local stand-in server."""
+
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+import pytest
+
+from notify import client
+
+
+class _Kestrel:
+    """Stand-in Kestrel that records every request and replies from a script."""
+
+    def __init__(self, statuses):
+        self.statuses = list(statuses)
+        self.keys = []
+        server = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_POST(self):
+                server.keys.append(self.headers["Idempotency-Key"])
+                self.rfile.read(int(self.headers["Content-Length"]))
+                status = server.statuses.pop(0)
+                if status == 200:
+                    body = json.dumps({"message_id": "m-1"}).encode()
+                    self.send_response(200)
+                    self.send_header("Content-Type", "application/json")
+                    self.send_header("Content-Length", str(len(body)))
+                    self.end_headers()
+                    self.wfile.write(body)
+                else:
+                    self.send_response(status)
+                    self.end_headers()
+                    self.wfile.write(b"boom")
+
+            def log_message(self, *args):
+                pass
+
+        self.http = HTTPServer(("127.0.0.1", 0), Handler)
+        threading.Thread(target=self.http.serve_forever, daemon=True).start()
+
+    @property
+    def url(self):
+        return f"http://127.0.0.1:{self.http.server_port}/v1"
+
+
+@pytest.fixture
+def kestrel(monkeypatch):
+    monkeypatch.setenv("KESTREL_TOKEN", "test-token")
+    monkeypatch.setattr(client, "BACKOFF", 0.01)
+
+    def build(statuses):
+        server = _Kestrel(statuses)
+        monkeypatch.setattr(client, "BASE", server.url)
+        return server
+
+    yield build
+
+
+def test_retries_reuse_one_idempotency_key(kestrel):
+    """An attempt that reached Kestrel must not be delivered twice on retry."""
+    server = kestrel([503, 503, 200])
+
+    assert client.send("+15550100", "disk full") == "m-1"
+    assert len(server.keys) == 3
+    assert len(set(server.keys)) == 1
+
+
+def test_exhausted_retries_reuse_one_idempotency_key(kestrel):
+    server = kestrel([503, 503, 503])
+
+    with pytest.raises(RuntimeError):
+        client.send("+15550100", "disk full")
+    assert len(set(server.keys)) == 1
+
+
+def test_separate_sends_get_separate_keys(kestrel):
+    """Distinct alerts must stay distinct; only retries collapse."""
+    server = kestrel([200, 200])
+
+    client.send("+15550100", "disk full")
+    client.send("+15550100", "disk full")
+    assert len(set(server.keys)) == 2
+
+
+def test_client_error_is_not_retried(kestrel):
+    """429 and other 4xx raise straight away, as the rate-limit docs state."""
+    server = kestrel([429])
+
+    with pytest.raises(Exception):
+        client.send("+15550100", "disk full")
+    assert len(server.keys) == 1
