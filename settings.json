{
  "cleanupPeriodDays": 36500,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "skillListingBudgetFraction": 0.05,
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "TELEGRAM_HITL_STATE_DIR": "/home/alan/personal/telegram-hitl",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_ENABLE_CFC": "false",
    "BASH_MAX_TIMEOUT_MS": "2147483647"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "ReportFindings",
      "ScheduleWakeup"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "dataviz": "name-only",
    "claude-api": "name-only",
    "workflow-authoring": "name-only",
    "claude-in-chrome": "name-only",
    "update-config": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "loop": "user-invocable-only",
    "schedule": "user-invocable-only",
    "run": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "alan-coding-style": "name-only",
    "alan-writing-style": "name-only",
    "codebase-analysis": "name-only",
    "copy-writing-style": "name-only",
    "decision-critic": "name-only",
    "deepthink": "name-only",
    "diagnose-workflow": "name-only",
    "do": "name-only",
    "doc-sync": "name-only",
    "incoherence": "name-only",
    "leon-writing-style": "name-only",
    "notes": "name-only",
    "planner": "name-only",
    "planner-lite": "name-only",
    "problem-analysis": "name-only",
    "prompt-engineer": "name-only",
    "refactor": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools env-context",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools hook-subagent-start",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|worker_permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools ntfy-hook --action notify --type permission",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools ntfy-hook --action notify --type idle",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools ntfy-hook --action notify --type question",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools ntfy-hook --action notify --type question",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "quota_auto_resume_fired",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools ntfy-hook --action notify --type resumed",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "quota_auto_resume_stale",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools ntfy-hook --action notify --type stalled",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools ntfy-hook --action notify --type stalled",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools ntfy-hook --action stop",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools hook-provenance || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools ntfy-hook --action cancel",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools hook-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools hook-pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools hook-post",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools hook-provenance || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools hook-post",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tools hook-provenance || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "playwright-skill@playwright-skill": true,
    "commit-commands@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "writing-prose-like-a-human-for-agents@writing-prose-like-a-human-for-agents": false,
    "claude-md-management@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "playwright-skill": {
      "source": {
        "source": "github",
        "repo": "lackeyjb/playwright-skill"
      }
    },
    "writing-prose-like-a-human-for-agents": {
      "source": {
        "source": "github",
        "repo": "kylehughes/writing-prose-like-a-human-for-agents"
      }
    }
  },
  "outputStyle": "default",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "autoCompactWindow": 600000,
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": true
}
