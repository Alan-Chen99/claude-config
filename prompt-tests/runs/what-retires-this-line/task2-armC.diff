+#!/usr/bin/env python3
+"""Deny tool calls that could write, truncate or delete anything under queue/.
+
+queue/ holds the only copy of each settled row between the settlement job
+writing it and sync.sh posting it. Touching one file there aborts the job's
+whole in-flight batch, and the rows cannot be regenerated.
+
+Naming a queue path is not the only way to reach it: a bulk mutator rooted at
+the repo (`sed -i` over the tree, `find -delete`, `rm -r`, `git clean`,
+`xargs rm`) destroys rows without the word "queue" appearing anywhere. Two
+checks therefore run over each simple command in a Bash pipeline:
+
+  1. path check  - a write-capable utility with an operand under queue/
+  2. reach check - a mutating command whose scope contains queue/ and that
+                   carries no explicit exclusion
+
+A mutator's scope is not always its own operands: xargs takes paths from stdin
+(scope = the directories named anywhere in the pipeline, else cwd) and `git
+clean` takes none (scope = cwd).
+
+Reads of queue/ stay allowed. An unrecognized utility with a queue/ operand is
+denied - an unknown program pointed at live rows is the dangerous case.
+
+Cases, including the two incident shapes: .claude/hooks/test_protect_queue.py
+"""
+import json
+import re
+import shlex
+import sys
+from pathlib import Path
+
+HEREDOC_RE = re.compile(r"<<-?\s*[\"']?(\w+)[\"']?")
+
+PROJECT = Path(__file__).resolve().parents[2]
+QUEUE = PROJECT / "queue"
+
+REASON = (
+    "BLOCKED: this would write to or delete files under {queue}.\n"
+    "queue/ holds the only copy of each settled row between the settlement job "
+    "writing it and sync.sh posting it. There is no backup, a lost row cannot be "
+    "regenerated, and touching one open file aborts the job's entire in-flight "
+    "batch. Two production incidents came from exactly this, both from agents "
+    "doing unrelated work.\n"
+    "Why this call: {detail}\n"
+    "Do instead: scope the command to a directory that is not queue/, or exclude "
+    "it explicitly (find . -path ./queue -prune -o ... , grep --exclude-dir=queue). "
+    "To inspect a row, copy it to your scratch directory and work on the copy. If "
+    "the task really is to change or remove a file under queue/, stop and tell the "
+    "user - that is an ops action. Do not work around this hook."
+)
+
+# Utilities that only read the paths they are given. `find` reads unless it
+# carries a mutating action, which the reach check handles.
+READ_ONLY = {
+    "cat", "head", "tail", "less", "more", "grep", "egrep", "fgrep", "rg", "wc",
+    "ls", "stat", "file", "du", "jq", "diff", "cmp", "sort", "uniq", "cut", "tr",
+    "awk", "md5sum", "sha1sum", "sha256sum", "basename", "dirname", "realpath",
+    "xxd", "od", "nl", "column", "find", "test", "[", "echo", "printf", "true",
+    "false", "cd", "pwd", "which", "env",
+}
+INPLACE = {"sed", "gsed", "perl", "ruby"}
+DESTRUCTIVE = {
+    "rm", "rmdir", "unlink", "shred", "truncate", "mv", "cp", "tee", "dd",
+    "install", "ln", "chmod", "chown",
+}
+FIND_MUTATING = {"-delete", "-exec", "-execdir", "-ok", "-okdir", "-fls", "-fprint"}
+# Producers that walk a directory tree: their operands are the roots whose
+# paths xargs will receive. Any other producer (a list file, an echo) has
+# contents this guard cannot see, so its scope is treated as unbounded.
+WALKERS = {"find", "fd", "ls", "grep", "egrep", "fgrep", "rg", "git", "locate"}
+XARGS_FLAGS_WITH_ARG = {
+    "-n", "-I", "-P", "-d", "-s", "-L", "-E", "-a", "--max-args", "--replace",
+    "--max-procs", "--delimiter", "--max-chars", "--max-lines", "--arg-file",
+}
+OPERATORS = {"|", "||", "&&", ";", "&", "(", ")", "\n"}
+REDIRECTS = {">", ">>", "1>", "2>", "&>", ">|"}
+EXCLUSION_MARKERS = ("-prune", "--exclude-dir=queue", "--exclude-dir queue")
+
+
+def strip_heredocs(command):
+    """Drop heredoc bodies: they are data, not commands.
+
+    Without this, writing a file that merely mentions queue/ - this repo's own
+    documentation, for one - parses as commands operating on queue/.
+    """
+    lines = command.split("\n")
+    out, i = [], 0
+    while i < len(lines):
+        out.append(lines[i])
+        marker = HEREDOC_RE.search(lines[i])
+        i += 1
+        if marker:
+            terminator = marker.group(1)
+            while i < len(lines) and lines[i].strip() != terminator:
+                i += 1
+            i += 1
+    return "\n".join(out)
+
+
+def tokenize(command):
+    lex = shlex.shlex(strip_heredocs(command), posix=True, punctuation_chars=True)
+    lex.whitespace_split = True
+    return list(lex)
+
+
+def segments(tokens):
+    """Split a token stream into simple commands on shell control operators."""
+    out, cur = [], []
+    for tok in tokens:
+        if tok in OPERATORS:
+            if cur:
+                out.append(cur)
+            cur = []
+        else:
+            cur.append(tok)
+    if cur:
+        out.append(cur)
+    return out
+
+
+def resolve(token, cwd):
+    # A non-recursive glob only reaches the directory it names, so keep the
+    # literal prefix and let a pure glob resolve to nothing.
+    stripped = token.split("*")[0].split("?")[0]
+    if not stripped:
+        return None
+    p = Path(stripped)
+    if not p.is_absolute():
+        p = cwd / p
+    try:
+        return Path(p.resolve())
+    except OSError:
+        return None
+
+
+def under_queue(path):
+    return path is not None and (path == QUEUE or QUEUE in path.parents)
+
+
+def reaches_queue(path):
+    """True when a bulk operation rooted at `path` can descend into queue/."""
+    return path is not None and (
+        path == QUEUE or QUEUE in path.parents or path in QUEUE.parents
+    )
+
+
+# Writers whose only written path is the last operand; the rest are read.
+DEST_ONLY = {"cp", "ln", "install"}
+
+
+def bare_operands(words):
+    out = []
+    for w in words[1:]:
+        if w.startswith("-"):
+            continue
+        # dd names its paths as of=/if= rather than positionally.
+        out.append(w.split("=", 1)[1] if w[:3] in ("of=", "if=") else w)
+    return out
+
+
+def xargs_subcommand(words):
+    """The command xargs runs, with its flags intact, after xargs' own options."""
+    i = 1
+    while i < len(words):
+        tok = words[i]
+        if tok.startswith("-"):
+            base = tok.split("=")[0]
+            i += 2 if base in XARGS_FLAGS_WITH_ARG and "=" not in tok else 1
+            continue
+        return words[i:]
+    return []
+
+
+def mutator_scope(words, upstream, cwd):
+    """Paths a mutating command can reach, or None when it does not mutate.
+
+    `upstream` is the list of simple commands piped into this one.
+    """
+    util = Path(words[0]).name
+    flags = [w for w in words[1:] if w.startswith("-")]
+    ops = bare_operands(words)
+
+    if util == "xargs":
+        sub = xargs_subcommand(words)
+        if not sub or mutator_scope(sub, upstream, cwd) is None:
+            return None
+        # Paths arrive on stdin, so the scope is whatever the producer walked.
+        roots = [resolve(t, cwd) for u in upstream if Path(u[0]).name in WALKERS
+                 for t in bare_operands(u)]
+        return roots or [cwd]
+    if util == "find":
+        if not any(f.split("=")[0] in FIND_MUTATING for f in flags):
+            return None
+        return [resolve(t, cwd) for t in ops] or [cwd]
+    if util == "git":
+        if not ops or ops[0] != "clean":
+            return None
+        return [resolve(t, cwd) for t in ops[1:]] or [cwd]
+    if util in INPLACE:
+        if not any("i" in f.lstrip("-") for f in flags):
+            return None
+        return [resolve(t, cwd) for t in ops] or [cwd]
+    if util in DEST_ONLY:
+        return [resolve(t, cwd) for t in ops[-1:]] or [cwd]
+    if util in DESTRUCTIVE:
+        return [resolve(t, cwd) for t in ops] or [cwd]
+    return None
+
+
+def check_bash(command, cwd):
+    try:
+        tokens = tokenize(command)
+    except ValueError:
+        # Unparseable quoting: bash would fail too. A literal scan keeps a
+        # malformed command from smuggling a queue path past the guard.
+        if "queue" in command:
+            return "command names queue/ and could not be parsed safely."
+        return None
+
+    parsed = segments(tokens)
+
+    for index, words in enumerate(parsed):
+        for i, tok in enumerate(words):
+            if tok in REDIRECTS and i + 1 < len(words):
+                if under_queue(resolve(words[i + 1], cwd)):
+                    return "it redirects output onto a file under queue/."
+        words = [w for w in words if w not in REDIRECTS]
+        if not words:
+            continue
+        util = Path(words[0]).name
+
+        # cp/ln/install write only their last operand; other writers write all.
+        if util in DEST_ONLY:
+            targets = bare_operands(words)[-1:]
+        elif util in READ_ONLY:
+            targets = []
+        else:
+            targets = bare_operands(words)
+        for tok in targets:
+            if under_queue(resolve(tok, cwd)):
+                return f"`{util}` can write, and names {resolve(tok, cwd)}."
+
+        scope = mutator_scope(words, parsed[:index], cwd)
+        if scope is None or any(m in command for m in EXCLUSION_MARKERS):
+            continue
+        for root in scope:
+            if reaches_queue(root):
+                return (
+                    f"`{util}` mutates files under {root}, which contains queue/, "
+                    "and the command carries no exclusion for it."
+                )
+    return None
+
+
+def main():
+    payload = json.load(sys.stdin)
+    tool = payload.get("tool_name", "")
+    tool_input = payload.get("tool_input") or {}
+    cwd = Path(payload.get("cwd") or PROJECT)
+
+    detail = None
+    if tool in {"Edit", "Write", "NotebookEdit", "MultiEdit"}:
+        target = resolve(str(tool_input.get("file_path", "")), cwd)
+        if under_queue(target):
+            detail = f"{tool} targets {target}."
+    elif tool == "Bash":
+        detail = check_bash(tool_input.get("command", ""), cwd)
+
+    if detail:
+        print(json.dumps({
+            "hookSpecificOutput": {
+                "hookEventName": "PreToolUse",
+                "permissionDecision": "deny",
+                "permissionDecisionReason": REASON.format(queue=QUEUE, detail=detail),
+            }
+        }))
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
