+#!/usr/bin/env python3
+"""PreToolUse guard for queue/.
+
+queue/ holds the only copy of each settled row between the settlement job
+writing it and sync.sh posting it. A row touched while the settlement job has
+it open aborts the in-flight batch and every row in that batch is unrecoverable.
+
+Both losses so far came from repo-wide commands that never mentioned queue/ --
+a `sed -i` sweep and a `find -delete` cleanup -- so this matches on command
+SHAPE (a bulk driver combined with a mutating verb), not on the word "queue".
+"""
+import json
+import os
+import re
+import sys
+
+# Anything that expands one command across many files: the reason a task
+# confined to pack.py or to scratch files still reaches queue/.
+BULK_DRIVER = re.compile(
+    r"""(?x)
+      \bfind\b | \bxargs\b | \bfd\b
+    | \bgrep\b[^|;&]*\s-\w*[rR]
+    | \bls\b[^|;&]*\s-\w*R
+    | \bgit\s+ls-files\b
+    | \s-\w*[rR]\b | \s--recursive\b
+    | \*
+    """
+)
+
+# Verbs that rewrite or remove whatever set of files they are handed. Paired
+# with a bulk driver these are the incident shape.
+BULK_VERB = re.compile(
+    r"""(?x)
+      \bsed\b[^|;&]*\s-\w*i | \bperl\b[^|;&]*\s-\w*i
+    | \brm\b | \bunlink\b | \bshred\b | \btruncate\b | \bdd\b
+    | \bmv\b | \bchmod\b | \bchown\b | \bchattr\b
+    | -delete\b | -exec\w*\b
+    """
+)
+
+# A redirect or tee writes one named target, so it cannot sweep a directory --
+# it is only dangerous when the command names a path under queue/. Keeping it
+# out of the bulk rule avoids blocking ordinary "write a file" commands that
+# happen to carry a glob somewhere else.
+NAMED_VERB = re.compile(BULK_VERB.pattern + r"| \btee\b | >", re.VERBOSE)
+
+# Inherently recursive destroyers: denied with or without a bulk driver.
+ALWAYS_BULK = re.compile(r"\bgit\s+clean\b|\brsync\b[^|;&]*--delete")
+
+# An author who has thought about queue/ and scoped it out.
+PRUNES_QUEUE = re.compile(
+    r"""(?x)
+      (-prune|--exclude-dir=|--exclude=|-not\s+-path|!\s+-path|:!)[^|;&]{0,40}queue
+    | queue[^|;&]{0,24}-prune
+    """
+)
+
+NAMES_QUEUE = re.compile(r"(^|[\s'\"=/])\.?/?queue(/|\b)")
+
+HOW = (
+    "If the command genuinely needs to run: re-scope it so queue/ cannot be "
+    "reached -- name the files explicitly, or prune queue/ "
+    "(find . -path ./queue -prune -o ... ; grep --exclude-dir=queue). "
+    "If it genuinely needs to touch queue/, stop and ask the user first."
+)
+
+WHY = (
+    "BLOCKED by .claude/hooks/guard-queue.py: queue/ holds the only copy of "
+    "each settled row. There is no backup and a lost row cannot be "
+    "regenerated -- touching a file under queue/ while the settlement job has "
+    "it open aborts the whole in-flight batch. Two production incidents came "
+    "from exactly this, both from agents whose actual task was elsewhere in "
+    "the repo."
+)
+
+
+def deny(detail):
+    json.dump(
+        {
+            "hookSpecificOutput": {
+                "hookEventName": "PreToolUse",
+                "permissionDecision": "deny",
+                "permissionDecisionReason": f"{WHY}\n\n{detail}\n\n{HOW}",
+            }
+        },
+        sys.stdout,
+    )
+    sys.exit(0)
+
+
+payload = json.load(sys.stdin)
+tool = payload.get("tool_name", "")
+tool_input = payload.get("tool_input") or {}
+
+project = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
+queue_dir = os.path.realpath(os.path.join(project, "queue"))
+
+if tool in {"Edit", "Write", "MultiEdit", "NotebookEdit"}:
+    path = tool_input.get("file_path") or tool_input.get("notebook_path") or ""
+    if path:
+        target = os.path.realpath(os.path.join(project, path))
+        if target == queue_dir or target.startswith(queue_dir + os.sep):
+            deny(f"{tool} targets {path}, which is inside queue/.")
+
+elif tool == "Bash":
+    command = tool_input.get("command", "")
+    if not PRUNES_QUEUE.search(command):
+        if ALWAYS_BULK.search(command):
+            deny("This command deletes recursively by its nature.")
+        bulk = BULK_VERB.search(command)
+        if bulk and BULK_DRIVER.search(command):
+            deny(
+                f"This command applies a mutating operation ({bulk.group(0).strip()}) "
+                "across a set of files it does not enumerate, so it can reach "
+                "queue/ even though the task is elsewhere."
+            )
+        if NAMED_VERB.search(command) and NAMES_QUEUE.search(command):
+            deny("This command names a path under queue/ and modifies files.")
diff -ruN prompt-tests/general/what-retires-this-line/fixture/.claude/hooks/test_guard.py /tmp/ptcc.DCvmkXc4/.claude/hooks/test_guard.py
