+#!/usr/bin/env python3
+"""Cases for protect-queue.py. Run: python3 .claude/hooks/test_protect_queue.py
+
+Each case pipes a real PreToolUse payload to the real hook and asserts only
+whether the call is denied. DENY cases include the two shapes that caused the
+production incidents: a repo-wide `sed -i` and a temp-file cleanup sweep, neither
+of which mentions queue/. ALLOW cases pin the collateral damage the guard must
+not cause - reads of queue/, edits elsewhere in the repo, and cleanup scoped to a
+scratch directory outside the repo.
+"""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+HOOK = Path(__file__).resolve().parent / "protect-queue.py"
+PROJECT = str(Path(__file__).resolve().parents[2])
+SCRATCH = "/root/.claude/tmp/claude-0/session/scratchpad"
+
+DENY = [
+    ("Edit", {"file_path": f"{PROJECT}/queue/row-1.json"}),
+    ("Write", {"file_path": "queue/row-1.json"}),
+    ("Edit", {"file_path": f"{PROJECT}/queue/nested/row-1.json"}),
+    ("Bash", {"command": "rm queue/row-1.json"}),
+    ("Bash", {"command": "rm -rf queue"}),
+    ("Bash", {"command": "rm -rf ."}),
+    ("Bash", {"command": "find . -name '*.tmp' -delete"}),
+    ("Bash", {"command": "find . -type f -name '*.json' -exec sed -i 's/a/b/' {} +"}),
+    ("Bash", {"command": "grep -rl old . | xargs sed -i 's/old/new/g'"}),
+    ("Bash", {"command": "sed -i 's/a/b/' queue/row-1.json"}),
+    ("Bash", {"command": "git clean -fdx"}),
+    ("Bash", {"command": "echo '{}' > queue/row-1.json"}),
+    ("Bash", {"command": "echo '{}' >> queue/row-1.json"}),
+    ("Bash", {"command": "python3 fixup.py queue/row-1.json"}),
+    ("Bash", {"command": "mv queue/row-1.json /tmp/"}),
+    ("Bash", {"command": "truncate -s 0 queue/row-1.json"}),
+    ("Bash", {"command": "cp /tmp/row.json queue/row-1.json"}),
+    ("Bash", {"command": "ls pack.py && rm queue/row-1.json"}),
+    ("Bash", {"command": f"rm -r {PROJECT}/queue"}),
+    ("Bash", {"command": "chmod -R 000 queue"}),
+    ("Bash", {"command": "dd if=/dev/null of=queue/row-1.json"}),
+    ("Bash", {"command": "cat rows.txt | xargs rm"}),
+    ("Bash", {"command": "cd /tmp && rm -rf " + PROJECT}),
+    ("Bash", {"command": "cat > queue/row-1.json <<'EOF'\n{}\nEOF"}),
+    ("Bash", {"command": "echo '{}' > queue/row-2.json"}),
+]
+
+ALLOW = [
+    ("Edit", {"file_path": f"{PROJECT}/pack.py"}),
+    ("Write", {"file_path": f"{PROJECT}/notes.md"}),
+    ("Edit", {"file_path": f"{SCRATCH}/queue/scratch.json"}),
+    ("Read", {"file_path": f"{PROJECT}/queue/row-1.json"}),
+    ("Bash", {"command": "cat queue/row-1.json"}),
+    ("Bash", {"command": "ls queue"}),
+    ("Bash", {"command": "wc -l queue/row-1.json"}),
+    ("Bash", {"command": "jq . queue/row-1.json"}),
+    ("Bash", {"command": "find queue -name '*.json' | wc -l"}),
+    ("Bash", {"command": "cp queue/row-1.json /tmp/row.json"}),
+    ("Bash", {"command": "sed -i 's/a/b/' pack.py"}),
+    ("Bash", {"command": "sed -i 's/a/b/' *.py"}),
+    ("Bash", {"command": "grep -r old ."}),
+    ("Bash", {"command": "./sync.sh"}),
+    ("Bash", {"command": f"find {SCRATCH} -name '*.tmp' -delete"}),
+    ("Bash", {"command": f"rm -rf {SCRATCH}/work"}),
+    ("Bash", {"command": "find . -path ./queue -prune -o -name '*.tmp' -delete"}),
+    ("Bash", {"command": "rm -rf ./build"}),
+    ("Bash", {"command": "python3 pack.py fixtures/row-1.json"}),
+    ("Bash", {"command": "cp -r queue /tmp/queue-backup"}),
+    ("Bash", {"command": "ls | xargs echo"}),
+    ("Bash", {"command": f"find {SCRATCH} -print0 | xargs -0 rm"}),
+    ("Bash", {"command": "cat queue/row-1.json | jq .row_id"}),
+    # Heredoc bodies are data. Documenting queue/ must not read as touching it.
+    ("Bash", {"command": "cat > CLAUDE.md <<'MD'\nA command must not delete "
+                         "queue/ rows; rm -rf queue is banned.\nMD"}),
+    ("Bash", {"command": "echo 'never rm -r queue/ here'"}),
+    ("Bash", {"command": "grep -rn queue sync.sh"}),
+]
+
+
+def denied(tool, tool_input):
+    payload = json.dumps({"tool_name": tool, "tool_input": tool_input, "cwd": PROJECT})
+    out = subprocess.run([sys.executable, str(HOOK)], input=payload,
+                         capture_output=True, text=True, check=True)
+    if not out.stdout.strip():
+        return False, ""
+    body = json.loads(out.stdout)
+    decision = body["hookSpecificOutput"]["permissionDecision"]
+    return decision == "deny", body["hookSpecificOutput"]["permissionDecisionReason"]
+
+
+failures = []
+for tool, ti in DENY:
+    ok, _ = denied(tool, ti)
+    if not ok:
+        failures.append(f"NOT DENIED (should be): {tool} {ti}")
+for tool, ti in ALLOW:
+    ok, reason = denied(tool, ti)
+    if ok:
+        failures.append(f"DENIED (should not be): {tool} {ti}\n    {reason.splitlines()[0]}")
+
+print(f"{len(DENY)} deny cases, {len(ALLOW)} allow cases")
+if failures:
+    print("\n".join(failures))
+    sys.exit(1)
+print("all cases pass")
