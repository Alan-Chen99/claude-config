# Unified config for claude-config. Copy to .env (gitignored) and fill in.
# Loaded by src/claude_config/config.py at module import time.

# ntfy topic to push notifications to. Used by src/claude_config/ntfy_hook.py
# (via `agent-tools ntfy-hook ...` invoked from settings.json hooks).
# Unset → notifications disabled silently.
NTFY_TOPIC_URL=https://ntfy.sh/YOUR_TOPIC_HERE

# OpenRouter key for the claude-haiku 1-line notification summaries.
# Used by src/claude_config/ntfy_hook.py.
# Unset → notification body shows "[err] No API key".
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE

# Anthropic API key used ONLY for token-counting in
# docs/system-prompt-snapshot/{capture,regenerate}.py.
# Deliberately not named ANTHROPIC_API_KEY to avoid colliding with a
# user's general-purpose Claude API key in the shell environment.
ANTHROPIC_TOKEN_COUNT_API_KEY=sk-ant-YOUR_KEY_HERE

# opencode Langfuse plugin keys. `agent-tools opencode` maps these to the
# unprefixed variables expected by opencode-plugin-langfuse.
# Note: the plugin spells its base URL variable LANGFUSE_BASEURL.
OPENCODE_LANGFUSE_SECRET_KEY=sk-lf-YOUR_SECRET_KEY_HERE
OPENCODE_LANGFUSE_PUBLIC_KEY=pk-lf-YOUR_PUBLIC_KEY_HERE
OPENCODE_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
